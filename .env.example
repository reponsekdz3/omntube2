# ==============================================================================
# OmniTube Pro Production Environment Configuration
# ==============================================================================

# Node / Hosting Configuration
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# Supabase Persistent Database, Auth & Media Storage
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional Legacy / Expo Supabase Mirrors (if deploying with mobile/multi-target)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# LiveKit Real-Time WebRTC Streaming & Broadcaster Room Server
# ------------------------------------------------------------------------------
# Get your WebSocket URL from LiveKit Cloud or self-hosted LiveKit instance
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
EXPO_PUBLIC_LIVEKIT_URL=

# ------------------------------------------------------------------------------
# PostgreSQL / Cloud SQL Relational Database (Monetization & Creator Wallets)
# ------------------------------------------------------------------------------
# If SQL_HOST is provided, Drizzle ORM connects to your PostgreSQL instance.
# If omitted or offline, OmniTube uses a safe in-memory persistence fallback.
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
DATABASE_URL=

# ------------------------------------------------------------------------------
# Optional Firebase Integration (if using supplementary Firebase tools)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=